# =========================================================================
# ShopSense Multi-Vendor Analytics Platform - React Admin Frontend Dockerfile
# Milestone 4: Multi-Stage Build & Containerization
# =========================================================================

# Stage 1: Build React/Vite application
FROM node:20-alpine AS build

WORKDIR /app

# Copy root manifests and frontend manifests
COPY package*.json ./
COPY frontend/package*.json ./frontend/

# Install dependencies
RUN npm --prefix frontend install

# Copy frontend source
COPY frontend/ ./frontend/

# Build production bundle
ARG VITE_API_URL="http://localhost:8000"
ENV VITE_API_URL=$VITE_API_URL

RUN npm --prefix frontend run build

# Stage 2: Serve with lightweight high-performance Nginx
FROM nginx:1.25-alpine

COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
