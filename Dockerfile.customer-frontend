# =========================================================================
# ShopSense Customer Storefront - React Customer Frontend Dockerfile
# Milestone 4: Multi-Stage Build & Containerization
# =========================================================================

# Stage 1: Build React/Vite application
FROM node:20-alpine AS build

WORKDIR /app

# Copy manifests
COPY package*.json ./
COPY customer-frontend/package*.json ./customer-frontend/

# Install dependencies
RUN npm --prefix customer-frontend install

# Copy customer frontend source
COPY customer-frontend/ ./customer-frontend/

# Build production bundle
ARG VITE_API_URL="http://localhost:8001"
ENV VITE_API_URL=$VITE_API_URL

RUN npm --prefix customer-frontend run build

# Stage 2: Serve with Nginx
FROM nginx:1.25-alpine

COPY --from=build /app/customer-frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
